{
  "manifest_version": 3,
  "name": "DocStudio Bulk Image Generator",
  "version": "1.0.0",
  "description": "Bulk AI image generator bridge for Documentary Studio. Automatically generates project visual shots in Meta AI and syncs them back into your documentary cut.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.meta.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DocStudio Bulk Image Generator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.meta.ai/*"],
      "js": ["content_meta_ai.js"],
      "run_at": "document_idle"
    }
  ]
}
