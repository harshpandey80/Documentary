# OpenRouter API Key (Supports MiniMax M3, Claude, GPT, etc.)
OPENROUTER_API_KEY=
DOCSTUDIO_LLM_PROVIDER=gemini
DOCSTUDIO_MODEL=gemini-3.8-flash

# Groq API Key (High-throughput reasoning fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini API Key (Primary)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Pexels API Key for high-def stock b-roll
PEXELS_API_KEY=

# Pixabay API Key for royalty-free stock footage, music, and sound effects
PIXABAY_API_KEY=

# Default Narrator Voice (Edge-TTS options: en-US-ChristopherNeural, en-US-GuyNeural, en-GB-RyanNeural)
DOCSTUDIO_VOICE=en-US-ChristopherNeural
DOCSTUDIO_VOICE_RATE=+25%

# Default Subtitle Style: documentary, hormozi, mrbeast
DOCSTUDIO_CAPTION_STYLE=hormozi

# Output Aspect Ratio: 16:9 (horizontal documentary) or 9:16 (vertical reel/short)
DOCSTUDIO_ASPECT_RATIO=9:16

# Audio Mixing Balance: Narration Voice MUST ALWAYS be greater than background music and SFX
DOCSTUDIO_VOICE_GAIN=1.00
DOCSTUDIO_MUSIC_GAIN=0.16
DOCSTUDIO_DUCKING_DB=-24.0
DOCSTUDIO_SFX_GAIN=0.22
DOCSTUDIO_ROOM_TONE_GAIN=0.18

